# Prefix absolut yang ditulis Vite ke index.html hasil build.
# Harus cocok dengan rewrite di .htaccess root:
#   RewriteRule ^react-assets/(.*)$ lib/frontend/web/react/public/$1 [L]
VITE_BASE_PATH=/osc414/react-assets/

# Prefix instalasi katalog. Dipakai router React (basename) dan pemanggil
# API. Mengubahnya berarti pindah ke subfolder instalasi lain, dan seluruh
# tautan PHP di lib/src/routes.ts juga harus disesuaikan.
VITE_CATALOG_BASE=/osc414

# Target proxy Vite dev server.
# HARUS origin polos tanpa path. Vite meneruskan path request apa adanya,
# jadi kalau ditulis http://localhost/osc414 maka permintaan
# /osc414/api/storefront/dashboard akan diteruskan menjadi
# /osc414/osc414/api/storefront/dashboard dan berakhir 404.
#
# Perhatikan: karena berawalan VITE_, nilainya juga disuntikkan ke
# import.meta.env dan ikut terembed ke bundle browser. Karena itu isinya
# hanya alamat lokal, jangan pernah menaruh hostname produksi, API key, atau
# kredensial di sini. Variabel yang benar-benar hanya dipakai server side
# sebaiknya memakai awalan yang tidak dibaca Vite, misalnya DEV_PROXY_TARGET,
# dan dibaca lewat process.env di vite.config.ts.
VITE_DEV_PROXY_TARGET=http://localhost

# Catatan pemakaian dev server:
#   npm.cmd run dev
#   lalu buka http://localhost:5173/osc414/  (bukan localhost:5173/),
#   karena basename router React diset ke /osc414.